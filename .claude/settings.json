{
  "enabledPlugins": {
    "devstd@dev-control": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "dev-control": {
      "source": {
        "source": "github",
        "repo": "chuhaiji/dev-control"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(ls:*)",
      "Bash(rg:*)"
    ]
  }
}
